# MoveTrack API Environment Variables

# Node Environment
NODE_ENV=development

# Server Port
PORT=3050

# Database Configuration
MT_DATALAYER_HOSTNAME=localhost
MT_DATALAYER_PORT=5432
MT_DATALAYER_DATABASE=movetrack_db
MT_DATALAYER_USERNAME=movetrack_user
MT_DATALAYER_PASSWORD=changeme123

# JWT Secret
JWT_SECRET=your-secret-key-change-in-production

# SendGrid Email Configuration (Optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=your-verified-email@example.com

# Vision AI Provider Configuration
# Default provider to use (claude, gpt4, or gemini)
VISION_PROVIDER=gemini

# Anthropic Claude API Key (for Claude 3.5 Sonnet Vision)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI API Key (for GPT-4o Vision)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Google AI API Key (for Gemini 2.0 Flash)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Note: You only need to configure API keys for the providers you want to use
# At least one provider must be configured for photo analysis to work
