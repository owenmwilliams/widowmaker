# MoveTrack API Environment Variables

# Node Environment
NODE_ENV=development

# Server Port
PORT=3050

# Database Configuration
MT_DATALAYER_HOSTNAME=localhost
MT_DATALAYER_PORT=5432
MT_DATALAYER_DATABASE=movetrack_db
MT_DATALAYER_USERNAME=movetrack_user
MT_DATALAYER_PASSWORD=changeme123

# JWT Secret
JWT_SECRET=your-secret-key-change-in-production

# SendGrid Email Configuration (Optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=your-verified-email@example.com

# Vision AI Provider Configuration
# Default provider to use (claude, gpt4, gemini, together-llama, together-qwen, florence, nemotron)
VISION_PROVIDER=gemini

# === PREMIUM PROVIDERS ===
# Anthropic Claude API Key (for Claude 3.5 Sonnet Vision)
# Get your key at: https://console.anthropic.com/
# Cost: ~$0.015 per image
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI API Key (for GPT-4o Vision)
# Get your key at: https://platform.openai.com/api-keys
# Cost: ~$0.01 per image
OPENAI_API_KEY=your-openai-api-key

# Google AI API Key (for Gemini 2.0 Flash)
# Get your key at: https://aistudio.google.com/app/apikey
# Cost: ~$0.01 per image
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Google Maps API Key (for route planning and geocoding)
# Get your key at: https://console.cloud.google.com/apis/credentials
# Required APIs: Maps JavaScript API, Directions API, Geocoding API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Cloud service account (local dev)
# Used for GCS access when running locally (should not be committed)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# === OPEN-SOURCE PROVIDERS (Pay-per-use) ===
# Together.ai API Key (for Llama Scout and Qwen Vision)
# Get your key at: https://api.together.xyz/settings/api-keys
# Llama-4-Scout: FREE credits with new accounts, then pay-per-use
# Qwen2.5-VL-72B: ~$0.0003-0.0005 per image (auto-scales to $0 when idle)
TOGETHER_API_KEY=your-together-api-key
# Optional: override model IDs
TOGETHER_SCOUT_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct
TOGETHER_QWEN_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# Hugging Face (for Florence-2 and Nemotron Vision)
# NOTE: These models are NOT available on free serverless API - requires paid Inference Endpoints
# Get a token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your-huggingface-token
# Optional: override model IDs
HUGGINGFACE_FLORENCE_MODEL=microsoft/Florence-2-base
HUGGINGFACE_NEMOTRON_MODEL=nvidia/Nemotron-4-140B-Vision-Instruction

# Basic plan limits
BASIC_MULTI_SCANS_PER_WEEK=3

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
STRIPE_PRICE_MOVE_PACK=price_xxx
APP_BASE_URL=https://movetrack-app.example.com

# Plan and admin flags (comma-separated emails, lowercase)
PRO_USERS=
ADMIN_USERS=

# Note: You only need to configure API keys for the providers you want to use
# At least one provider must be configured for photo analysis to work
# For cost-effective operation, use Together.ai providers (together-llama is FREE)
