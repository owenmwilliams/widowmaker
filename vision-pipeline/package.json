{
  "name": "vision-pipeline",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @vision/api dev",
    "dev:web": "pnpm --filter @vision/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "cd infra/db && pnpm prisma migrate dev",
    "db:generate": "cd infra/db && pnpm prisma generate",
    "db:studio": "cd infra/db && pnpm prisma studio"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}
