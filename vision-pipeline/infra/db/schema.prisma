generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ImageCapture {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now()) @map("created_at")
  userId       String?  @map("user_id")
  source       String   // 'upload' | 'url'
  originalUrl  String?  @map("original_url")
  gcsUrl       String?  @map("gcs_url")
  width        Int?
  height       Int?
  exifJson     Json?    @map("exif_json")
  sha256       String   @unique
  notes        String?

  predictions  Prediction[]
  itemRecords  ItemRecord[]
  crops        Crop[]

  @@map("image_capture")
  @@index([sha256])
}

model Prediction {
  id            String   @id @default(uuid())
  imageId       String   @map("image_id")
  provider      String   // 'openai' | 'anthropic' | 'google' | 'azure' | 'aws' | 'qwen' | 'llava' | 'custom'
  model         String
  latencyMs     Int      @map("latency_ms")
  costUsd       Float?   @map("cost_usd")
  rawResponse   Json     @map("raw_response")
  normalized    Json
  version       String   @default("1.0.0")
  createdAt     DateTime @default(now()) @map("created_at")

  image         ImageCapture @relation(fields: [imageId], references: [id], onDelete: Cascade)
  itemRecords   ItemRecord[]

  @@map("prediction")
  @@index([imageId])
}

model ItemRecord {
  id           String   @id @default(uuid())
  imageId      String   @map("image_id")
  predictionId String?  @map("prediction_id")
  normalized   Json     // ItemSchema JSON
  status       String   @default("draft") // 'draft' | 'confirmed' | 'rejected'
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  image        ImageCapture  @relation(fields: [imageId], references: [id], onDelete: Cascade)
  prediction   Prediction?   @relation(fields: [predictionId], references: [id], onDelete: SetNull)
  annotations  Annotation[]
  sourceRefs   SourceRef[]

  @@map("item_record")
  @@index([imageId])
  @@index([predictionId])
  @@index([status])
}

model Annotation {
  id        String   @id @default(uuid())
  itemId    String   @map("item_id")
  field     String
  oldValue  Json     @map("old_value")
  newValue  Json     @map("new_value")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  item      ItemRecord @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("annotation")
  @@index([itemId])
}

model Crop {
  id         String   @id @default(uuid())
  imageId    String   @map("image_id")
  bbox       Json     // {x, y, w, h}
  maskUrl    String?  @map("mask_url")
  derivedBy  String   // 'detector' | 'user' | 'manual'
  createdAt  DateTime @default(now()) @map("created_at")

  image      ImageCapture @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@map("crop")
  @@index([imageId])
}

model SourceRef {
  id         String   @id @default(uuid())
  itemId     String   @map("item_id")
  kind       String   // 'barcode' | 'ocr' | 'db' | 'llm'
  name       String?  // e.g., 'OpenLibrary', 'GS1'
  value      String?
  confidence Float?
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  item       ItemRecord @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("source_ref")
  @@index([itemId])
}
