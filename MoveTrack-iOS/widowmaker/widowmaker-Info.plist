<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.movetrack.MoveTrack</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>movetrack</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Nexus Moves uses your camera to capture photos and room walkthrough videos so it can build your moving inventory.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Nexus Moves lets you add photos and videos from your library to build your moving inventory.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Nexus Moves records audio with room walkthrough videos used to build your moving inventory.</string>
	<!-- The app uses only standard HTTPS/TLS (exempt encryption), so TestFlight/App
	     Store builds don't need an export-compliance review each upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
