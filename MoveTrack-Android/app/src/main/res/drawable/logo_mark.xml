<?xml version="1.0" encoding="utf-8"?>
<!-- Nexus Moves brand mark — the white "N-route" with the warm beacon dot.
     Ported from design/assets/logo-mark.svg (white mark, for dark/color
     backgrounds). The beacon is the one warm accent in the system. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="128"
    android:viewportHeight="128">
    <!-- Route -->
    <path
        android:pathData="M38,96 L38,42 L90,96 L90,48"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="17"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Beacon glow -->
    <path
        android:pathData="M72,42 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0"
        android:fillColor="#F98D5B"
        android:fillAlpha="0.28" />
    <!-- Beacon core -->
    <path
        android:pathData="M80.5,42 a9.5,9.5 0 1,0 19,0 a9.5,9.5 0 1,0 -19,0"
        android:fillColor="#F98D5B" />
    <!-- Beacon highlight -->
    <path
        android:pathData="M85.6,42 a4.4,4.4 0 1,0 8.8,0 a4.4,4.4 0 1,0 -8.8,0"
        android:fillColor="#FFE2D4" />
</vector>
